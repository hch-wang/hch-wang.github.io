---
layout: default
---
<div class="post demo-page">
  <header class="post-header demo-header">
    <h1 class="post-title" data-toc-skip>{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>

    {% assign demo_updated_at = page.last_updated_at | default: page.date %}
    {% assign demo_words = content | strip_html | number_of_words %}
    {% assign demo_readtime = demo_words | plus: 179 | divided_by: 180 %}
    {% if demo_readtime < 1 %}
      {% assign demo_readtime = 1 %}
    {% endif %}

    <div class="demo-meta-line" aria-label="Document metadata">
      {% if demo_updated_at %}
        <span class="demo-meta-item">
          <span>Modified</span>
          <time datetime="{{ demo_updated_at | date: '%Y-%m-%d' }}">{{ demo_updated_at | date: "%b %d, %Y" }}</time>
        </span>
      {% endif %}
      <span class="demo-meta-item">
        <span>Read</span>
        <span>{{ demo_readtime }} min</span>
      </span>
      {% if page.category %}
        <span class="demo-meta-item">
          <span>{{ page.category }}</span>
        </span>
      {% endif %}
    </div>
  </header>

  <article class="demo-content">
    {{ content }}
  </article>
</div>
